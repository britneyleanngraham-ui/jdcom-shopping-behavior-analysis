    <worksheet name='Shop Oppportunities'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Shop Engagement and Purchase Opportunity Matrix </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='customer_interactions (jdcom_analytics)' name='federated.0qkk9w41w4bi9h179qqdw1k7m7e4' />
          </datasources>
          <datasource-dependencies datasource='federated.0qkk9w41w4bi9h179qqdw1k7m7e4'>
            <column caption='Purchase Share' datatype='real' name='[Calculation_3978759825059841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([purchased]) / COUNT([candidate_record_id])' />
            </column>
            <column caption='Interaction Count' datatype='integer' name='[Calculation_3978759841509379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Valid Shop' datatype='boolean' name='[Calculation_3978759876440068]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[shop_id] &lt;&gt; &quot;-1&quot;' />
            </column>
            <column caption='Candidate Record Id' datatype='string' name='[candidate_record_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3978759876440068]' derivation='None' name='[none:Calculation_3978759876440068:nk]' pivot='key' type='nominal' />
            <column-instance column='[shop_id]' derivation='None' name='[none:shop_id:nk]' pivot='key' type='nominal' />
            <column caption='Purchased' datatype='integer' name='[purchased]' role='measure' type='quantitative' />
            <column caption='Shop Id' datatype='string' name='[shop_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3978759841509379]' derivation='Sum' name='[sum:Calculation_3978759841509379:qk]' pivot='key' type='quantitative' />
            <column-instance column='[purchased]' derivation='Sum' name='[sum:purchased:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3978759825059841]' derivation='User' name='[usr:Calculation_3978759825059841:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0qkk9w41w4bi9h179qqdw1k7m7e4].[none:Calculation_3978759876440068:nk]'>
            <groupfilter function='member' level='[none:Calculation_3978759876440068:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.0qkk9w41w4bi9h179qqdw1k7m7e4].[sum:Calculation_3978759841509379:qk]' included-values='in-range'>
            <min>100</min>
